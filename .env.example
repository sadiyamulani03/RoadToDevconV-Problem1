# Copy to .env and fill in real values. Never commit .env.
# No secrets are stored in this repository.

# Bee API endpoint (local development default)
BEE_API_URL=http://localhost:1633

# Feed identity (hex owner address derived from publisher private key; topic string)
FEED_OWNER=
FEED_TOPIC=

# Publisher private key (hex, 0x-prefixed). Required only for real publishing.
# Leave empty for read-only / recovery / status workflows.
FEED_PRIVATE_KEY=

# Usable postage batch id (hex, 64 chars). Required only for real uploads.
POSTAGE_BATCH_ID=
